---
import Base from '../layouts/Base.astro';
import Preloader from '../components/Preloader.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import Services from '../components/Services.astro';
import Problem from '../components/Problem.astro';
import Letter from '../components/Letter.astro';
import Process from '../components/Process.astro';
import Report from '../components/Report.astro';
import WontDo from '../components/WontDo.astro';
import Proof from '../components/Proof.astro';
import People from '../components/People.astro';
import Clients from '../components/Clients.astro';
import Credentials from '../components/Credentials.astro';
import Booking from '../components/Booking.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Preloader />
  <Nav />
  <Hero />
  <Ticker />
  <main>
    <Services />
    <Problem />
    <Letter />
    <Process />
    <Report />
    <WontDo />
    <Proof />
    <People />
    <Clients />
    <Credentials />
    <Booking />
  </main>
  <Footer />
</Base>

<script>
  import { initMotion } from '../scripts/motion';

  // Split text only after the brand fonts load, so line breaks are measured correctly.
  let started = false;
  const start = () => {
    if (started) return;
    started = true;
    initMotion();
  };
  document.fonts.ready.then(start);
  window.setTimeout(start, 1500);
</script>
